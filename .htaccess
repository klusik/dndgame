Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^install/?$ install.php [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^(config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>
